# DAP login credential for the local RocketRide engine (see
# ROCKETRIDE_python_API.md "Configuration"). The engine only requires this
# to be non-empty; for a default local dev engine (no ROCKETRIDE_APIKEY
# configured on the engine side) any value is accepted.
#
# Do NOT put a webhook node's "Private Token" (tk_...) here -- that's a
# task-scoped key tied to an already-running pipeline, not a login
# credential, and using it here fails with "Bad request".
ROCKETRIDE_APIKEY=local-dev

# Vision model used by the Ollama Vision node (pipelines/Claim_Process.pipe).
# Swap between these to A/B test damage-detection quality -- just change the
# value and restart ./run.sh, no pipeline edits needed. Must already be
# pulled locally: `ollama pull <model>`.
#   llava:latest              -- smaller/faster, more prone to hallucination
#   llava-llama3:latest       -- stronger llava variant, still broadly compatible
#   llama3.2-vision:latest    -- larger, generally more accurate, but needs an
#                                 Ollama version that supports the "mllama"
#                                 architecture -- confirmed failing with
#                                 "unknown model architecture: 'mllama'" on
#                                 Ollama 0.32.9. Check `ollama --version`
#                                 before relying on it.
ROCKETRIDE_VISION_MODEL=llava:latest
