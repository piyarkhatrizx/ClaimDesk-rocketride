    {
      "id": "prompt_1",
      "provider": "prompt",
      "name": "Claim Analysis Prompt",
      "config": {
        "instructions": [
          "Analyze this vehicle damage report. Respond with ONLY a valid JSON object, no markdown, no explanation, no preamble. Only describe damage you can clearly see in the description. Do not infer or assume damage that is not mentioned. If something is unclear, say unable to confirm. Use this exact schema: {\"summary\": \"A detailed 3-5 sentence description including: what type of collision occurred, which areas of the vehicle are damaged, the visible extent of damage (crushed, cracked, dented, scratched), any visible safety concerns (fluid leaks, deployed airbags, broken glass), and whether the vehicle appears structurally compromised\", \"severity\": \"Low|Moderate|Severe|Totaled\", \"damaged_parts\": [\"...\"], \"estimated_cost_range\": \"$X - $Y\", \"safety_hazards\": [\"...\"], \"drivable\": true/false, \"confidence\": {\"summary\": 85, \"severity\": 90, \"damaged_parts\": 75, \"estimated_cost_range\": 60, \"drivable\": 80}}"
        ],
        "prompt": "Analyze this vehicle damage report. Respond with ONLY a valid JSON object, no markdown, no explanation, no preamble. Only describe damage you can clearly see in the description. Do not infer or assume damage that is not mentioned. If something is unclear, say unable to confirm. Use this exact schema:\n{\"summary\": \"A detailed 3-5 sentence description including: what type of collision occurred, which areas of the vehicle are damaged, the visible extent of damage (crushed, cracked, dented, scratched), any visible safety concerns (fluid leaks, deployed airbags, broken glass), and whether the vehicle appears structurally compromised\", \"severity\": \"Low|Moderate|Severe|Totaled\", \"damaged_parts\": [\"...\"], \"estimated_cost_range\": \"$X - $Y\", \"safety_hazards\": [\"...\"], \"drivable\": true/false, \"confidence\": {\"summary\": 85, \"severity\": 90, \"damaged_parts\": 75, \"estimated_cost_range\": 60, \"drivable\": 80}}\n\nHere is the damage report to analyze:\n{input}",
        "name": "Claim Analysis Prompt",
        "parameters": {
          "google": {}
        }
