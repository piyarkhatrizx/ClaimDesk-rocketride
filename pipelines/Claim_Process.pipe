    {
      "id": "image_vision_ollama_1",
      "provider": "image_vision_ollama",
      "name": "Ollama Vision",
      "config": {
        "profile": "custom",
        "custom": {
          "serverbase": "http://localhost:11434/v1",
          "model": "${ROCKETRIDE_VISION_MODEL}",
          "modelTotalTokens": 32768,
          "systemPrompt": "You are a strictly literal, factual insurance damage assessor. Examine ONLY the single image attached to this specific request -- never reference or reuse a description from any other image or prior request. Examine this image strictly based on what is visibly proven. DO NOT guess how the accident happened. DO NOT assume the orientation of the vehicle. Some submitted claims have no real damage at all -- if the vehicle looks intact, say so plainly instead of inventing plausible-sounding damage.",
          "prompt": "Look only at the image attached to this message. List the visibly damaged parts in detail, but ONLY damage that is clearly and unambiguously visible in THIS image. If the vehicle appears intact with no clear damage, respond exactly with: 'No visible damage detected.' Be extremely literal. State if the vehicle is upright. Do not hallucinate missing parts, rollover damage, or cosmetic wear as if it were collision damage unless explicitly visible. Do not describe any vehicle other than the one shown in this attached image."
        },
        "name": "Ollama Vision",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 830,
          "y": 330
        },
        "nodeType": "default",
        "formDataValid": true
      },
