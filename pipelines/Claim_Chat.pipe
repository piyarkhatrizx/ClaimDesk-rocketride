    {
      "id": "agent_rocketride_1",
      "provider": "agent_rocketride",
      "name": "Claim Assistant",
      "config": {
        "agent_description": "You are an AI assistant for insurance adjusters. You have access to a claim report that was generated by the ClaimDesk AI pipeline. Help the adjuster understand the claim, answer questions about coverage, explain triage decisions, assess fraud risk, and recommend next steps. Be professional, concise, and cite specific details from the claim report.",
        "instructions": [
          "When the adjuster asks about the claim, reference specific details from the claim report provided in the conversation context. If asked about coverage, refer to standard auto insurance policy terms. If asked about fraud indicators, analyze contradictions between the description and damage assessment. Always be direct and professional."
        ],
        "max_waves": 2,
        "name": "Claim Assistant",
        "parameters": {}
      },
      "ui": {
        "position": {
          "x": 690,
          "y": 270
        },
        "nodeType": "default",
        "formDataValid": true
      },
      "input": [
        {
          "lane": "questions",
          "from": "chat_1"
        }
      ]
    },
